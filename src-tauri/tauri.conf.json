{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseDeck",
  "mainBinaryName": "pulse-deck",
  "version": "0.3.0",
  "identifier": "com.jianluo.pulsedeck",
  "build": {
    "beforeDevCommand": "npm run ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "脉盘 PulseDeck",
        "width": 1240,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
